{
    "name": "TCC PHP + Node.js",
    "image": "mcr.microsoft.com/devcontainers/php:8.2-node",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        },
        "ghcr.io/devcontainers/features/composer:1": {},
        "ghcr.io/devcontainers/features/mysql:1": {
            "version": "8.0",
            "mysqlDatabase": "basetcc",
            "mysqlUser": "root",
            "mysqlPassword": ""
        }
    },
    "postCreateCommand": "composer install && npm install",
    "customizations": {
        "vscode": {
            "extensions": ["bmewburn.vscode-intelephense-client", "xdebug.php-debug", "esbenp.prettier-vscode"]
        }
    },
    "forwardPorts": [8000, 5173, 3306],
    "remoteEnv": {
        "DB_CONNECTION": "mysql",
        "DB_HOST": "localhost",
        "DB_PORT": "3306",
        "DB_DATABASE": "tcc_db",
        "DB_USERNAME": "root",
        "DB_PASSWORD": ""
    }
}
