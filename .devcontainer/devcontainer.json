{
    "name": "PHP + Node Bullseye",
    "image": "mcr.microsoft.com/devcontainers/php:8.2-bullseye",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        }
    },
    "postCreateCommand": "composer install && npm install",
    "customizations": {
        "vscode": {
            "extensions": ["bmewburn.vscode-intelephense-client", "xdebug.php-debug", "esbenp.prettier-vscode"]
        }
    },
    "forwardPorts": [8000, 5173, 3306]
}
